{
  "mcpServers": {
    "interface": {
      "command": "uv",
      "args": [
        "run",
        "rag-eval",
        "server",
        "--log-file",
        "logs/mcp_server.log"
      ],
      "env": {
        "DATABASE_URL": "postgresql://postgres:postgres@localhost:1542/rag_db"
      }
    }
  }
}
